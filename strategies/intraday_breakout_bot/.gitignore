# Runtime artifacts created at import time by config.py. The data directory is
# tracked because it ships the universe (universe.json), the ranked candidate
# pool (candidates.csv) and the one-off generator; only its runtime contents
# (the journal) are ignored. `data/*` (not `data/`) is required: git cannot
# re-include a file whose parent directory is itself excluded.
data/*
!data/universe.json
!data/candidates.csv
!data/_gen_universe.py
__pycache__/
.pytest_cache/

# Our package ships its tests; the parent strategies/.gitignore excludes test/
# dirs used for runtime config copies. Un-ignore ours.
#
# `**` rather than `*.py`: git cannot re-include a file if a parent *directory*
# is excluded, so a nested helper (e.g. test/helpers/fakes.py) would still be
# dropped by a single-level pattern.
!test/
!test/**
# Later patterns win over the negation above, so re-exclude build artifacts.
test/**/__pycache__/
test/**/*.pyc
