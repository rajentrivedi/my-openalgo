# Runtime artifacts created at import time by config.py
data/
__pycache__/
.pytest_cache/

# Our package ships its tests; the parent strategies/.gitignore excludes test/
# dirs used for runtime config copies. Un-ignore ours.
#
# `**` rather than `*.py`: git cannot re-include a file if a parent *directory*
# is excluded, so a nested helper (e.g. test/helpers/fakes.py) would still be
# dropped by a single-level pattern.
!test/
!test/**
# Later patterns win over the negation above, so re-exclude build artifacts.
test/**/__pycache__/
test/**/*.pyc
