//@version=6
strategy(
     "Quantix FOMO Momentum Strategy",
     overlay = true,
     initial_capital = 100000,
     pyramiding = 0,
     commission_type = strategy.commission.percent,
     commission_value = 0.03,
     process_orders_on_close = true,
     calc_on_order_fills = true)

//========================================================
// INPUTS
//========================================================

// Session
tradeSession = input.session("0915-1515", "Trading Session")
openingRangeSession = input.session("0915-0945", "Opening Range")

// Gap
enableGapFilter = input.bool(true, "Enable Gap Filter")
minimumGap = input.float(2.0, "Minimum Gap %", step=0.1)

// Volume
enableRVOL = input.bool(true, "Enable Relative Volume")
rvolLength = input.int(20, "RVOL Length")
minimumRVOL = input.float(1.50, "Minimum RVOL")

// EMA
emaFastLength = input.int(20, "EMA Fast")
emaSlowLength = input.int(50, "EMA Slow")

// VWAP
enableVWAP = input.bool(true, "VWAP Filter")

// ATR
atrLength = input.int(14, "ATR Length")
atrSL = input.float(1.5, "ATR Stop")
atrTP = input.float(3.0, "ATR Target")

// ADX
enableADX = input.bool(true, "ADX Filter")
adxLength = input.int(14, "ADX Length")
minimumADX = input.float(20)

// Momentum Score
minimumScore = input.int(70, "Minimum Momentum Score", minval=0, maxval=100)

// Exit
exitHour = input.int(15)
exitMinute = input.int(15)

//========================================================
// DAILY RESET
//========================================================

newDay = ta.change(time("D"))

var bool tradedToday = false

if newDay
    tradedToday := false

//========================================================
// SESSION
//========================================================

inTradeSession =
    not na(time(timeframe.period, tradeSession))

inOpeningRange =
    not na(time(timeframe.period, openingRangeSession))

//========================================================
// OPENING RANGE
//========================================================

var float openingHigh = na
var float openingLow = na

if newDay
    openingHigh := na
    openingLow := na

if inOpeningRange

    openingHigh :=
        na(openingHigh)
        ? high
        : math.max(openingHigh, high)

    openingLow :=
        na(openingLow)
        ? low
        : math.min(openingLow, low)

//========================================================
// MOVING AVERAGES
//========================================================

ema20 = ta.ema(close, emaFastLength)
ema50 = ta.ema(close, emaSlowLength)

emaBull =
     close > ema20 and
     ema20 > ema50

//========================================================
// VWAP
//========================================================

vwapValue = ta.vwap(close)

vwapBull =
     close > vwapValue

//========================================================
// GAP
//========================================================

gapPercent =
     ((open - close[1]) / close[1]) * 100

gapPass =
     not enableGapFilter or
     gapPercent >= minimumGap

//========================================================
// RELATIVE VOLUME
//========================================================

averageVolume =
     ta.sma(volume, rvolLength)

relativeVolume =
     volume / averageVolume

rvolPass =
     not enableRVOL or
     relativeVolume >= minimumRVOL

//========================================================
// ATR
//========================================================

atr =
     ta.atr(atrLength)

//========================================================
// DIRECTIONAL MOVEMENT
//========================================================

upMove =
     high - high[1]

downMove =
     low[1] - low

plusDM =
     upMove > downMove and upMove > 0
     ? upMove
     : 0

minusDM =
     downMove > upMove and downMove > 0
     ? downMove
     : 0

trueRange =
     ta.tr(true)

atrDM =
     ta.rma(trueRange, adxLength)

plusDI =
     100 *
     ta.rma(plusDM, adxLength) /
     atrDM

minusDI =
     100 *
     ta.rma(minusDM, adxLength) /
     atrDM

dx =
     math.abs(plusDI - minusDI) /
     (plusDI + minusDI) * 100

adx =
     ta.rma(dx, adxLength)

adxPass =
     not enableADX or
     adx >= minimumADX

//========================================================
// BREAKOUT
//========================================================

openingBreakout =
     not na(openingHigh) and
     close > openingHigh

//========================================================
// PLOTS
//========================================================

plot(
     ema20,
     color=color.orange,
     linewidth=2,
     title="EMA20")

plot(
     ema50,
     color=color.blue,
     linewidth=2,
     title="EMA50")

plot(
     openingHigh,
     color=color.green,
     linewidth=2,
     style=plot.style_linebr,
     title="Opening High")

plot(
     openingLow,
     color=color.red,
     linewidth=2,
     style=plot.style_linebr,
     title="Opening Low")

plot(
     vwapValue,
     color=color.yellow,
     linewidth=2,
     title="VWAP")

//========================================================
// PART 1 END
//========================================================
